# 시연 데이터 서버(frontend/tools/sim_server.py) + 생성기. 빌드 문맥 = 11_automotive (docker-compose.yml의 context: ..)
# 켜는 프로필은 환경변수 MOM_PROFILE (video | final). 센서 CSV는 용량 때문에 깃에 없어서 이미지를 만들 때 한 번 생성한다 (같은 seed = 같은 결과, 약 15초)
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 TZ=Asia/Seoul
WORKDIR /app
COPY 생성기/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY 생성기 /app/생성기
COPY frontend/tools /app/frontend/tools
COPY 가상사내문서 /app/가상사내문서
ARG BUILD_PROFILE=final
RUN cd /app/생성기 && python generate.py --profile ${BUILD_PROFILE}
ENV MOM_SIM_HOST=0.0.0.0 MOM_SIM_PORT=8765
EXPOSE 8765
WORKDIR /app/frontend
CMD ["python", "tools/sim_server.py"]
