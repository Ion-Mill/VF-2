# 바깥에 열리는 문은 이 파일 하나(80·443). 자동 HTTPS(Let's Encrypt)는 도메인이 이 서버 IP를 가리키고 80·443이 열려 있어야 된다.
# 접속 비밀번호: .env 의 BASIC_USER / BASIC_HASH (해시 만드는 법은 배포_안내.md)
{$DOMAIN} {
	encode gzip

	basic_auth {
		{$BASIC_USER} {$BASIC_HASH}
	}

	# 시연 서버 (화면의 /api/*). 흐름(스트림)이 끊기지 않게 바로바로 내보낸다
	handle /api/* {
		reverse_proxy sim:8765 {
			flush_interval -1
		}
	}

	# 백엔드 (이브 채팅·음성 등, 화면의 NEXT_PUBLIC_MOM_API=/mom-api) — 앞의 /mom-api 를 떼고 넘긴다
	handle_path /mom-api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
