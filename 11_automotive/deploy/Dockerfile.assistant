# AI 비서 서비스(assistant/backend/chat_service.py, 포트 8100). 마이크(faster-whisper)는 ASSISTANT_VOICE=1 일 때만 쓰고,
# 모델 파일(large-v3-turbo 약 1.6GB)은 첫 요청 때 /models 볼륨으로 내려받는다.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 TZ=Asia/Seoul HF_HOME=/models
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY assistant/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY assistant/ .
EXPOSE 8100
CMD ["python", "-m", "uvicorn", "backend.chat_service:app", "--host", "0.0.0.0", "--port", "8100"]
