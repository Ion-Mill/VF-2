# 이 파일을 .env 로 복사해서 서버에서 값을 채운다 (.env 는 저장소에 올리지 않음)
# 접속 주소(도메인). 예: my-mom.duckdns.org  — DuckDNS에서 이 서버의 고정 IP를 가리키게 해 둘 것
DOMAIN=
# 평가자·팀이 접속할 때 쓰는 아이디와 비밀번호의 해시
#   해시 만들기:  docker run --rm caddy:2 caddy hash-password --plaintext '정한비밀번호'
#   나온 값($2a$14$...)을 넣을 때 $ 하나하나를 $$ 로 바꿔 쓴다 (compose가 $를 변수로 읽기 때문)
BASIC_USER=
BASIC_HASH=
# 시연 서버 프로필: final(평가자 접속용) | video(영상용)
MOM_PROFILE=final
# 시연 서버의 문장 다듬기(외부 LLM 사용) 0|1 — 비서 키가 들어 있을 때만 1
MOM_LLM_COMPOSE=0
# 발표자 키: 최종용에서 [처음으로]를 부를 때 머리글 X-Presenter-Key 로 보내는 값. 길고 아무도 모르는 문자열로 (비우면 거절)
MOM_PRESENTER_KEY=
# 리허설용 가짜 현재 시각 (예: 2026-10-26T17:00). 발표 때는 반드시 비운다
MOM_PRETEND_NOW=
# 시연 서버 → 백엔드 DB 중계 열쇠 (시연 서버·백엔드 둘 다 이 값을 받는다). 길고 무작위로
MOM_INGEST_KEY=
# 백엔드가 중계를 받는지 (기본 true). 서버를 켤 때 공용 DB가 시연 기준점으로 되돌아간 뒤 지금까지 따라잡는다
MOM_SIM_SYNC=true
# 화면에서 [처음으로] 등 시연 조작을 할 수 있는 사용자 (쉼표로, 예: U12). 비우면 로그인한 누구나
MOM_SIM_CONTROL_USERS=
