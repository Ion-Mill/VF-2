# 화면(Next.js). NEXT_PUBLIC_* 은 빌드할 때 박히므로 주소를 바꾸면 다시 빌드해야 한다.
# 브라우저는 같은 주소(Caddy)로만 부른다: /api/* → 시연 서버, /mom-api/* → 백엔드 (Caddyfile)
FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG NEXT_PUBLIC_MOM_API=/mom-api
ENV NEXT_PUBLIC_MOM_API=${NEXT_PUBLIC_MOM_API} SIM_SERVER=http://sim:8765 NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
