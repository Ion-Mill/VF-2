# AI 비서 서비스 설정 예시. 이 파일을 .env 로 복사해서 쓴다 (.env 는 git 에 올라가지 않는다).
#   cp .env.example .env
# 기본은 "외부로 아무것도 안 나감": LLM 을 부르지 않고 규칙·기본 문장으로만 답한다.

# ---- 기존 백엔드(11_automotive/backend)와 잇기 -------------------------------------
# 이 서비스: uvicorn backend.chat_service:app --host 127.0.0.1 --port 8100   (assistant/ 폴더에서, 밖에 열지 않는다)
# 백엔드 쪽 .env 에는 MOM_ASSISTANT_URL=http://127.0.0.1:8100 과 아래와 같은 MOM_ASSISTANT_KEY 를 넣는다.
MOM_ASSISTANT_KEY=        # 백엔드와 같은 값(긴 무작위 글자). 비어 있으면 서비스는 모든 요청을 401 로 거절한다
MOM_BACKEND_URL=http://127.0.0.1:8000     # 조회 도구를 부를 백엔드 주소 (POST {주소}/api/assistant/tools/{도구}). 비어 있으면 운영 데이터 질문은 503
# MOM_BACKEND_TIMEOUT_S=10                # 백엔드 조회 한 번의 시간 제한(초)

# ---- 외부 Claude 를 쓰려면 아래 네 줄을 켠다 (MANIFEST.md 3절) ----------------
# Claude Code CLI 가 설치돼 있고 구독으로 로그인돼 있어야 한다 (claude auth status).
# 요청에 "llm" 칸은 없다 — Claude 로 보낼지는 이 서버 설정(ASSISTANT_PROVIDER)으로만 정한다.
ASSISTANT_PROVIDER=local  # local = 규칙 + (켜면) 로컬 LLM / claude = 모든 요청을 외부 Claude 로 (EXTERNAL_LLM_APP=1 도 필요)
EXTERNAL_LLM_APP=0        # 1 = 서버 허용. 0 이면 외부로 한 글자도 안 나간다 (claude 로 두고 0 이면 503)
LLM_ENABLED=0             # 1 = LLM 호출 허용. 0 이면 규칙·기본 문장만
LLM_JOBS=write,route      # LLM 이 하는 일 (LLM_ENABLED=1 일 때만 의미가 있다)

# ---- 원본 앱이 켠 동작 스위치 (규칙 보강·문지기 등, MANIFEST.md 3절) ----------
NUM_MATCH=value
PARSE_V2=1
ROUTE_POLICY=llm_guarded
DOC_GATE=tiered
PARSE_V3=1
SPLIT_Q=1
PARSE_V4=1
PARSE_V5=1
PARSE_V6=1
PARSE_V7=1
FOLLOWUP=0                # 이어 묻기는 첫 판에서 끈다 — 기존 백엔드는 앞 답 번호(answer_id)가 아니라 history 를 보낸다 (나중 개선)
PARSE_V8=1
FOLLOWUP_V2=0
PARSE_V9=1
FLOW_V9=1
BLOCKS_V2=1
PARSE_V10=1
FLOW_V10=1
BLOCKS_V3=1
DOC_WRITE=1
PARSE_V11=1
LEAD_V12=1
TERM_V13=1
ANSWER_GATE_V17=1
TABLE_FILL_V18=1
RETRIEVAL=bm25

# ---- 필요할 때만 -------------------------------------------------------------
# MOM_CLAUDE_CWD=C:\llm\claude_cli_cwd   # claude -p 를 돌릴 빈 작업 폴더 (저장소 밖이어야 한다)
# MOM_CLAUDE_BIN=                        # Claude Code 실행 파일 경로 (PATH 에 없을 때)
# EXTERNAL_PROC_LIMIT=8                  # 동시에 도는 claude 프로세스 상한
# STEP_LOG=0                             # 1 = 단계별 로그를 STEP_LOG_DIR 에 남긴다
# STEP_LOG_DIR=C:\llm\logs

# 쓰지 않는 값: THINK_APP (로컬 Qwen 전용), LLM_URL·LLM_MODEL·LLM_API_KEY (로컬 Qwen 서버용), DATABASE_URL (pgvector 를 쓸 때만)
