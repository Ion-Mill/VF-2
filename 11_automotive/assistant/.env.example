# AI 비서 서비스 설정 예시. 이 파일을 .env 로 복사해서 쓴다 (.env 는 git 에 올라가지 않는다).
#   cp .env.example .env
# 기본은 "외부로 아무것도 안 나감": LLM 을 부르지 않고 규칙·기본 문장으로만 답한다.

# ---- 기존 백엔드(11_automotive/backend)와 잇기 -------------------------------------
# 이 서비스: uvicorn backend.chat_service:app --host 127.0.0.1 --port 8100   (assistant/ 폴더에서, 밖에 열지 않는다)
# 백엔드 쪽 .env 에는 MOM_ASSISTANT_URL=http://127.0.0.1:8100 과 아래와 같은 MOM_ASSISTANT_KEY 를 넣는다.
# 백엔드와 같은 값(긴 무작위 글자). 비어 있으면 서비스는 모든 요청을 401 로 거절한다
MOM_ASSISTANT_KEY=
# 조회 도구를 부를 백엔드 주소 (POST {주소}/api/assistant/tools/{도구}). 비어 있으면 운영 데이터 질문은 503
MOM_BACKEND_URL=http://127.0.0.1:8000
# MOM_BACKEND_TIMEOUT_S=10                # 백엔드 조회 한 번의 시간 제한(초)

# ---- 외부 Claude 를 쓰려면 아래 네 줄을 켠다 (MANIFEST.md 3절) ----------------
# Claude Code CLI 가 설치돼 있고 구독으로 로그인돼 있어야 한다 (claude auth status).
# 요청에 "llm" 칸은 없다 — Claude 로 보낼지는 이 서버 설정(ASSISTANT_PROVIDER)으로만 정한다.
# local = 규칙 + (켜면) 로컬 LLM / claude = 모든 요청을 외부 Claude 로 (EXTERNAL_LLM_APP=1 도 필요)
ASSISTANT_PROVIDER=local
# 1 = 서버 허용. 0 이면 외부로 한 글자도 안 나간다 (claude 로 두고 0 이면 503)
EXTERNAL_LLM_APP=0
# 1 = LLM 호출 허용. 0 이면 규칙·기본 문장만
LLM_ENABLED=0
# LLM 이 하는 일 (LLM_ENABLED=1 일 때만 의미가 있다)
LLM_JOBS=write,route

# ---- 순수 외부 LLM 연결 + 말투·형식 (추가 묶음 claude_bundle_addon_20261016, 실험 기능) -------
# 켜면 문서 질문은 "문서 조각 8개 + 질문 -> 외부 Claude 1번 -> 그 답"으로 답한다. **이 길에는 숫자·허락·지시 코드 검사가 없다**
# (안전은 Claude 지시문과 코드에 고정된 끝 안전 문구뿐). 외부 Claude 요청(ASSISTANT_PROVIDER=claude + EXTERNAL_LLM_APP=1 + LLM_ENABLED=1)일 때만 작동.
# 전부 0 이면 추가 묶음 없이 본체와 똑같이 돈다. 값 옆에 설명을 쓰지 않는다(설명이 값으로 읽힌다).
# 1 = 순수 길 사용
PURE_EXTERNAL=0
# 1 = 말투: 옆자리 선배가 풀어서 설명하듯 (PURE_EXTERNAL=1 일 때만 뜻이 있다)
PURE_STYLE=0
# 1 = 형식: 소제목·한 문장·번호 목록 (PURE_STYLE=1 일 때만 뜻이 있다)
PURE_LAYOUT=0
# 1 = 알람 번호·날짜·설비·운영 낱말이 든 질문은 기존 길(알람 카드·백엔드 조회 도구) / 0 = 그런 질문도 순수 길로(운영 기록은 조회 못 한다고 답함)
PURE_KEEP_SIGNALS=0
# Claude 에게 주는 문서 조각 수 (1~20)
PURE_TOPK=8
# 1 = 검색 상위 조각에 아래 절이 있으면 짧은 것부터 최대 4개·2,500자를 같이 준다. "잠금 표지 순서"처럼 낱말이 다른 아래 절(DOC-05 §2.1 작업 전 6단계)을 놓쳐 "문서에 없다"고 틀리게 답하던 안전 결함의 수정 (PURE_EXTERNAL=1 일 때만 뜻이 있다)
PURE_EXPAND=1
# 1 = 순수 길의 안전 질문(잠금·차단·보호구·설비 이름 …)에 안전 작업 기준서 DOC-05를 통째로 주고, 그래도 답이 없으면 "문서에 없다" 대신 "자동으로 확인하지 못함 + 가까운 절"로 답한다. 설비 이름만 든 안전 질문은 PURE_KEEP_SIGNALS=1에서도 순수 길로 간다. "톱 정비 전에 어디를 차단해야 해?"가 문서에 있는 차단 지점을 "없다"고 답하던 결함의 수정 (PURE_EXTERNAL=1 일 때만 뜻이 있다)
PURE_SAFETY=1
# 1 = 순수 길에서 질문에 기간 낱말(한 달에 한 번·분기·반기·매년·일주일에 …)과 정비 낱말(정비·점검·교체 …)이 함께 있으면 예방 정비 기준서 DOC-04의 그 기간 절(§2.1~2.7)을 빠뜨리지 않고 Claude에게 준다. "한 달에 한 번 하는 정비"가 문서에 있는 월간 항목을 "없다"고 답하던 결함의 수정 (PURE_EXTERNAL=1·PURE_EXPAND=1 일 때만 뜻이 있다)
PURE_PERIOD=1
# 1 = 질문에 운영 낱말(로트·재고·정비 기한·알림)만 있고 지금 상태를 묻는 말이 없고 규칙 낱말(누가·기준·방식·순서·어떻게 해야·수 있어?·얼마마다 …)이 있으면 운영 조회가 아니라 사내 문서로 답한다. 문서에 없으면 원래 운영 조회로 되돌린다. "소모품 재고는 누가 관리해?"가 재고 목록만 돌려주던 결함의 수정 (PURE_EXTERNAL=1·PURE_KEEP_SIGNALS=1 일 때만 뜻이 있다)
PURE_RULE=1
# 1 = 순수 길에서 Claude가 "조각에 답이 없다"고 한 질문을 상위 30개 조각(PURE_RETRY_TOPK)으로 한 번 더 묻고, 그래도 없을 때만 "문서에 없음"으로 끝낸다. 정답 조각이 검색 9~50위에 있어 못 보낸 것을 "문서에 없다"고 말하던 일을 줄인다(보내는 글자가 재시도 때만 최대 약 65,000자). 안전 질문·PURE_RULE 경로에는 안 쓴다. 0 = 끔.
PURE_RETRY=1
# 1 = 질문에 운영 낱말(수명·재고·정지·로트 …)만 있고 행동을 묻는 말(어떻게 해, 뭐부터 확인, 다시 돌려도 돼, 어떤 값으로 …)이 있고 데이터를 묻는 말(몇 개·목록·현황·이력 …)이 없으면 운영 조회가 아니라 사내 문서로 답한다. 문서에 없으면 원래 운영 조회로 되돌린다(Claude 호출 1~2회 추가). 알람 번호·설비 이름·로트 번호·날짜가 든 질문은 안 바뀐다. 0 = 끔.
PURE_FAULT=1
# 1 = 질문에 고장 낱말(알람·경고·떴어·멈췄어·정지·고장·에러·과열·누설 …)이 있으면 고장 대응 매뉴얼(DOC-03)을 통째로(최대 30,000자) Claude에게 준다. DOC-03을 현장 말로 물으면 정답 절이 검색 상위 8개 밖에 있어 놓치던 일을 줄인다(해당 질문의 요청 글이 약 28,000자 커진다). 0 = 끔.
PURE_FAULTDOC=1
# 1 = 채팅에서 화면 알람(alarm_key)이 있을 때 "원인은?"·"누가 해야 돼?"처럼 자기 대상이 없는 질문만 직전 알람으로 이어받는다(답 맨 앞에 "N 알람 기준으로 답해요."). 자기 대상이 있는 질문·"아까" 같은 과거 지시어·이어 묻기 문장은 안 이어받는다. 꺼지면(0·줄 없음) 예전 규칙 그대로
CTX_NARROW=1
# 1 = 이어 묻기 "쉽게/짧게"가 순수 길(Claude가 쓴) 답의 글을 실제로 다시 쓴다. 숫자·영문 이름·조건 말·길이를 프로그램이 대조하고 뜻이 같은지 따로 판정하며, 안전 낱말(잠금·표지·고전압 …)이 든 줄은 원문 그대로 둔다. 하나라도 걸리면 앞 답을 그대로 보인다. 꺼지면(0·줄 없음) 앞 답을 그대로 보인다. 켜면 "쉽게/짧게" 한 번에 Claude 호출 2번(약 10~20초)
PURE_FOLLOW_REWRITE=1
# 1 = 운영 낱말(로트·재고·정비 기한·알림)뿐인 질문 중 규칙 낱말(누가·기준이 뭐야 …)이 없어도 조회 말투(몇 개·있어?·알려줘·모자란·중에 …)가 아니면 사내 문서 길로 보낸다. PURE_RULE의 재현율을 올린다(독립 은행 35% 안팎 → 목표 75%). 문서에 없으면 원래 길로 되돌린다. 0 = 끔.
PURE_RULE_WIDE=1

# ---- 원본 앱이 켠 동작 스위치 (규칙 보강·문지기 등, MANIFEST.md 3절) ----------
NUM_MATCH=value
PARSE_V2=1
ROUTE_POLICY=llm_guarded
DOC_GATE=tiered
PARSE_V3=1
SPLIT_Q=1
PARSE_V4=1
PARSE_V5=1
PARSE_V6=1
PARSE_V7=1
# 이어 묻기 (2026-10-18 켬): 비서 서비스(chat_service)가 사용자별 바로 앞 답을 30분 동안 직접 기억해 쓴다 — 백엔드가 history 를 안 보내도 된다
FOLLOWUP=1
PARSE_V8=1
FOLLOWUP_V2=1
PARSE_V9=1
FLOW_V9=1
BLOCKS_V2=1
PARSE_V10=1
FLOW_V10=1
BLOCKS_V3=1
DOC_WRITE=1
PARSE_V11=1
LEAD_V12=1
TERM_V13=1
ANSWER_GATE_V17=1
TABLE_FILL_V18=1
RETRIEVAL=bm25

# ---- 필요할 때만 -------------------------------------------------------------
# MOM_CLAUDE_CWD=C:\llm\claude_cli_cwd   # claude -p 를 돌릴 빈 작업 폴더 (저장소 밖이어야 한다)
# MOM_CLAUDE_BIN=                        # Claude Code 실행 파일 경로 (PATH 에 없을 때)
# EXTERNAL_PROC_LIMIT=8                  # 동시에 도는 claude 프로세스 상한
# STEP_LOG=0                             # 1 = 단계별 로그를 STEP_LOG_DIR 에 남긴다
# STEP_LOG_DIR=C:\llm\logs

# 쓰지 않는 값: THINK_APP (로컬 Qwen 전용), LLM_URL·LLM_MODEL·LLM_API_KEY (로컬 Qwen 서버용), DATABASE_URL (pgvector 를 쓸 때만)
