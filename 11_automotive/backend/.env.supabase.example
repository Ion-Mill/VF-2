# API 서버를 Supabase DB(mom-db)에 붙일 때. 복사해서 .env.supabase 로 쓰고 <...>만 바꾼다. 저장소에 넣지 않는다.
#   uvicorn app.main:app --env-file .env.supabase
#   먼저 확인: python tools/check_connection.py --env-file .env.supabase
# 비밀번호에 @ : / ? # % 가 있으면 주소 안에서 %40 처럼 바꿔 써야 한다 (만들 때 영문·숫자·-_ 만 쓰면 편함)

# 앱 계정 (읽기·쓰기) / 비서 조회 계정 (읽기 전용) — supabase/load_data.sh 때 정한 MOM_APP_DB_PASSWORD·MOM_AI_DB_PASSWORD
# Session pooler(5432)만: 실시간 알림(LISTEN)은 Transaction pooler(6543)에서 안 된다. 사용자 이름 뒤에 .<project-ref>
MOM_DATABASE_URL=postgresql+psycopg://mom_app.vbzcpjkraxxemsyrhwel:<MOM_APP_DB_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
MOM_READONLY_DATABASE_URL=postgresql+psycopg://mom_ai_ro.vbzcpjkraxxemsyrhwel:<MOM_AI_DB_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Session pooler는 역할마다 Pool Size(무료 기본 15)까지만 접속을 받는다.
# 이 값이면 서버 1대가 앱 계정 연결을 최대 2+1+1(실시간)=4개 쓴다 → 팀원 3~4명이 동시에 띄울 수 있다
# (서버 한 대를 여럿이 같이 쓰는 공용 서버라면 4·2)
MOM_DB_POOL_SIZE=2
MOM_DB_MAX_OVERFLOW=1

# 로그인 토큰 서명 키 — 같은 DB를 쓰는 서버끼리 달라도 되지만, 한 서버에서 받은 토큰은 그 서버에서만 통한다
MOM_JWT_SECRET=<32자 이상 무작위>
MOM_JWT_MINUTES=720
MOM_INGEST_KEY=<무작위>
MOM_ASSISTANT_KEY=<무작위>

MOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 공용 DB는 시연 모드 끔 (2026-10-20, 팀과 논의/비서_시뮬레이터_DB_연결_논의 3-1). 켜면 로그인 없이 역할 토큰(POST /api/demo/role)이
# 나오고, 시연 되돌리기(POST /api/sim/reset)가 공용 DB 운영 데이터를 비우고 기준점으로 덮는다. 개인 로컬 DB에서만 true
# (화면의 [처음으로]는 시연 서버를 부르므로 이 값과 상관없다)
MOM_DEMO_MODE=false

# 스케줄러(목표 미달·승인 대기 알림 등)는 같은 DB에 붙은 서버 중 "한 대만" true (DB 담당). 나머지 조원 서버는 false
MOM_RUN_WORKERS=false
# CMM 결과 파일 감시 폴더 (Windows에서는 /data/... 가 없으므로 backend 안 폴더로)
MOM_CMM_INBOX_DIR=./cmm/inbox
MOM_CMM_PROCESSED_DIR=./cmm/processed
MOM_CMM_ERROR_DIR=./cmm/error

MOM_ASSISTANT_URL=
