# 복사해서 .env 로 쓰고 값을 바꾼다. .env 는 저장소에 넣지 않는다 (NFR-SEC-06)
MOM_OWNER_DB_PASSWORD=change-me-owner
MOM_APP_DB_PASSWORD=change-me-app
MOM_AI_DB_PASSWORD=change-me-ai

# 로그인 토큰 서명 키 — 32자 이상 무작위 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
MOM_JWT_SECRET=
MOM_JWT_MINUTES=720
# 시뮬레이터(X-Service-Key: ingest)·AI 비서 서비스(X-Service-Key: assistant) 키
MOM_INGEST_KEY=
MOM_ASSISTANT_KEY=

MOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 시연 모드: 역할 바꿔 보기·시계 조작·알람 주입을 누구나 (운영은 false)
MOM_DEMO_MODE=true
# 처음 띄울 때(빈 DB) 넣을 것 — 생성기 데이터 + 사내 문서 (VF-2/11_automotive 폴더 필요, 기본 .. = 상위 11_automotive)
MOM_LOAD_DATA=1
# AUTOMOTIVE_DIR=C:/Dev/IonMill/VF-2/11_automotive
# 센서 약 98만 행(DB +약 120MB)·10/1 리허설 기록도 넣기
MOM_LOAD_SENSOR=0
MOM_LOAD_REALTIME=0
# 시연 계정 U01~U12 비밀번호 (개발·시연 전용 — 운영 금지, 비우면 로그인 불가)
MOM_DEMO_PASSWORD=
# MOM_LOAD_DATA=0 일 때 작은 개발 목업(시험용)을 넣기
MOM_DEV_SEED=0
# 스케줄러·CMM 파일 감시를 이 서버에서 돌리기 (서버 여러 대면 한 곳만 true)
MOM_RUN_WORKERS=true
# CMM 측정 시작 뒤 결과를 기다리는 분 [선택 필요: 기술 회의]
MOM_CMM_NO_RESULT_MINUTES=10
MOM_CMM_POLL_SECONDS=2
# AI 비서 서비스 주소 (로컬 LLM — 비우면 비서 질문은 NO_RESPONSE·작업기록 정리는 ASSISTANT_UNAVAILABLE, 화면은 기본 문구)
MOM_ASSISTANT_URL=http://127.0.0.1:8100
# 비서 응답을 기다리는 시간(초). 화면은 130초와 여유로 기다린다
MOM_ASSISTANT_TIMEOUT_SECONDS=130
# [제안] 출하 확정 전 로트 QR을 모두 찍어야 하는지 (2026-10-13 QR 가정, 기본 false)
MOM_QR_SHIP_CHECK_REQUIRED=false
